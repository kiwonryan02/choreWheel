# Supabase project URL and public (anon / publishable) key.
# Dashboard -> Project Settings -> API. Never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# VAPID *public* key for Web Push (safe to ship in the bundle). Leave unset to
# turn push off. The matching private key lives only in Supabase Edge Function
# secrets; see docs/PUSH_SETUP.md.
VITE_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
